# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Runtime data: database artifacts and imagery must never be committed.
# (.gitkeep files keep the directory layout tracked in git.)
data/**
!data/**/
!data/**/.gitkeep

# Node / Electron
node_modules/
dist/
build/
release/

# Packaged installers (the directory layout stays tracked via .gitkeep)
assets/installers/*
!assets/installers/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
